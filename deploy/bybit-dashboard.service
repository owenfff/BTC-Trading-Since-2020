[Unit]
Description=Quant read-only operator dashboard
After=network.target

[Service]
Type=simple
User=quantbot
Group=quantbot
WorkingDirectory=/opt/btc-trading-bot
ExecStart=/usr/bin/python3 /opt/btc-trading-bot/frontend/server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btc-trading-bot/quant/outputs

[Install]
WantedBy=multi-user.target
