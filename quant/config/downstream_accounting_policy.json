{
  "schema_version": "M0-AUTONOMOUS-1.0",
  "policy_id": "DOWNSTREAM_BEHAVIORAL_ACCOUNTING_V1",
  "teacher_data_type": "TRADE_RECORDS_ONLY",
  "accounting_eligibility": {
    "eligible_normalization_statuses": ["PASS", "WARNING"],
    "blocked_normalization_statuses": ["BLOCKED"],
    "rule": "accounting_eligible = normalization_status in {PASS, WARNING}"
  },
  "ledgers": {
    "exchange_reported_accounting": {
      "purpose": "Preserve values reported by the exchange and wallet exports without treating them as reconstructed state.",
      "fields": ["realisedPnl", "execComm", "Funding", "walletHistory", "position_snapshot.currentCost", "position_snapshot.avgEntryPrice"]
    },
    "analytical_accounting": {
      "purpose": "Deterministic behavioral replay using quantity, execution cost, analytical gross PnL, AEP, cycles, and confidence flags.",
      "fields": ["signed_contract_qty", "position_before", "position_after", "action", "execCost", "analytical_gross_realised_pnl", "analytical_aep", "position_cycle_id", "confidence_flags"]
    }
  },
  "fidelity": {
    "quantity_fidelity": "EXACT",
    "execution_price_fidelity": "EXACT_OR_AUDITED_RECOVERED",
    "fee_fidelity": "REPORTED_EXCHANGE_VALUE",
    "funding_fidelity": "REPORTED_EXCHANGE_VALUE",
    "wallet_fidelity": "PENDING_WALLET_RECONCILIATION",
    "current_cost_engine_fidelity": "HIGH_CONFIDENCE_WITH_RESIDUAL",
    "aep_engine_fidelity": "HIGH_CONFIDENCE_WITH_ENGINE_SEMANTICS_UNRESOLVED",
    "execution_order_fidelity": "PARTIAL_WITH_CONFIDENCE_FLAGS"
  },
  "downstream_behavioral_research_status": "READY_WITH_KNOWN_ACCOUNTING_RESIDUALS",
  "exact_teacher_labels_forbidden": ["exchange_internal_currentCost", "exchange_internal_AEP", "unproven_cross_order_sequence", "post-cycle_future_outcomes"],
  "btc_first_symbols": ["XBTUSD"]
}
